SECRET_KEY=django-insecure-candle-ecommerce-dev-secret-key-change-me
DEBUG=True
# Production database URL. Use MySQL for Himalayan Host shared hosting, for example:
# DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DATABASE
DATABASE_URL=postgres://candle_user:candle_pass@localhost:5432/candle_ecommerce
ALLOWED_HOSTS=localhost,127.0.0.1,nismitacraftstudio.com
CORS_ALLOWED_ORIGINS=https://nismitacraftstudio.com,http://nismitacraftstudio.com

# --- eSewa merchant gateway (optional) ---
# Leave empty to keep the manual WhatsApp payment flow; fill in your merchant
# credentials from the eSewa partner dashboard to enable online checkout.
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
ESEWA_PRODUCT_ID=EPAY0000000
# Absolute callback URL (optional — defaults to /payment/esewa/callback/ on this site)
ESEWA_CALLBACK_URL=

# The live customer checkout uses the existing QR + WhatsApp/manual verification flow.
# Optional gateway variables are retained for a future, separately-reviewed flow.
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
ESEWA_PRODUCT_ID=EPAY0000000
ESewa_CALLBACK_URL=

# --- Production operations ---
TRUST_PROXY_HEADERS=false
DATABASE_CONN_MAX_AGE=60
DATABASE_CONNECT_TIMEOUT=5
CSRF_TRUSTED_ORIGINS=
WHATSAPP_NUMBER=977XXXXXXXXX
SHIPPING_FLAT=150
